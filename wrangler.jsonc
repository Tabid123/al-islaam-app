// Cloudflare production configuration for Al-islaam TanStack/Nitro build
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-islaam-app",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "AMTEL_API_ENABLED": "true"
  },
  "assets": {
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "preview_urls": true
}
